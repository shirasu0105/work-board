{
  "_comment": "ハーネスが必要とする許可の正規定義。各ツール固有の権限モデルへ sync-harness.mjs が展開する。Claude Code は Bash 単位、Codex CLI は sandbox_mode + approval、Copilot は IDE UI で個別承認。",
  "claude": {
    "allow": [
      "mcp__playwright__*",
      "mcp__ide__getDiagnostics",
      "Bash(taskkill /F /IM node.exe)",
      "Bash(cmd /c \"taskkill /F /IM node.exe\")",
      "Bash(powershell *)",
      "Bash(npx tsc *)",
      "Bash(node -e ' *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(echo \"PID: $!\")",
      "Read(//mnt/c/work/AIWork/**)",
      "Bash(echo \"Background PID: $!\")",
      "Bash(npx cross-env *)",
      "Bash(npx prisma *)"
    ],
    "enableAllProjectMcpServers": true,
    "enabledMcpjsonServers": ["aidesigner"]
  },
  "codex": {
    "_note": "Codex CLI はサンドボックスと承認ポリシーで制御する（Bash 単位の allow リストではない）。",
    "default_sandbox_mode": "workspace-write",
    "default_approval_policy": "on-request"
  },
  "copilot": {
    "_note": "VS Code Copilot は MCP ツールごとに IDE 上で個別承認する。設定ファイルでの一括許可は持たない。"
  }
}
